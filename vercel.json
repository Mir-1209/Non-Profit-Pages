{
  "buildCommand": "BASE_PATH=/ NODE_ENV=production pnpm --filter @workspace/gcl-website run build",
  "outputDirectory": "artifacts/gcl-website/dist",
  "installCommand": "pnpm install",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/:path*",     "destination": "/index.html" }
  ]
}
