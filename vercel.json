{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "installCommand": "pnpm install",

  "buildCommand": "cd artifacts/gcl-website && BASE_PATH=/ NODE_ENV=production pnpm run build",

  "outputDirectory": "artifacts/gcl-website/dist/public",

  "framework": null,

  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    }
  },

  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/:path*",     "destination": "/index.html" }
  ]
}
