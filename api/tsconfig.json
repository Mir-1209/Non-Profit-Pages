{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "types": ["node"],
    // Vercel's esbuild bundler resolves workspace packages via pnpm symlinks
    // in node_modules; "bundler" resolution follows the `exports` field in
    // each package.json, which points directly to TypeScript source files.
    "moduleResolution": "bundler"
  },
  "include": ["."],
  "references": [
    { "path": "../artifacts/api-server" },
    { "path": "../lib/db" },
    { "path": "../lib/api-zod" }
  ]
}
